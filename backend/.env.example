# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Ads API Credentials (optional for live production sync)
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_CUSTOMER_ID=482-910-2391
GOOGLE_ADS_REFRESH_TOKEN=your-oauth2-refresh-token

# Server Port
PORT=8000
